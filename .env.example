DISCORD_TOKEN=replace-me
DISCORD_APPLICATION_ID=123456789012345678
DISCORD_ALLOWED_USER_IDS=123456789012345678
DISCORD_ALLOWED_GUILD_IDS=234567890123456789
DISCORD_ALLOWED_CHANNEL_IDS=

ODOO_WORKSPACE=/Users/axelmanzanilla/odoo/versions/19.0
CLAUDE_BIN=claude
CLAUDE_MODEL=
CLAUDE_MCP_CONFIG=
CLAUDE_MCP_SERVER_NAME=Odoo

# Set to false to run without an Odoo MCP server at all: Claude then answers only
# from the source tree in ODOO_WORKSPACE and never reaches an Odoo database.
# Leaving this true makes a missing MCP server block every request.
CLAUDE_REQUIRE_MCP=true

CLAUDE_SETTING_SOURCES=user,project,local
CLAUDE_PERMISSION_MODE=dontAsk

# Accepts the built-in read tools (Read, Glob, Grep, WebFetch, WebSearch) plus
# MCP tool names that are explicitly read-like. Anything mutation-shaped fails
# startup validation. Code-search-only deployments should drop the mcp__Odoo__*
# entries; see "Deployment profiles" in README.md.
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep,mcp__Odoo__search,mcp__Odoo__read

CLAUDE_TIMEOUT_MS=900000
CLAUDE_MAX_BUDGET_USD=5
MAX_CONCURRENT_REQUESTS=1
MAX_QUEUED_REQUESTS=50

DATABASE_PATH=./data/bot.sqlite3
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=30000
