[Unit]
Description=Odoo Claude Discord bridge
Documentation=https://github.com/axelmanzanilla/odoo-claude-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Dedicated unprivileged account. Its home is the systemd state directory below,
# not /home, so ProtectHome=true can stay on:
#   sudo useradd --system --home-dir /var/lib/odoo-claude-bot \
#     --shell /usr/sbin/nologin odoo-claude
User=odoo-claude
Group=odoo-claude

WorkingDirectory=/opt/odoo-claude-bot
ExecStart=/usr/bin/node dist/index.js

# Secrets live in a root-owned file readable only by the service account:
#   sudo install -o root -g odoo-claude -m 0640 .env /etc/odoo-claude-bot.env
EnvironmentFile=/etc/odoo-claude-bot.env

# Creates and owns /var/lib/odoo-claude-bot, and makes it writable under
# ProtectSystem=strict. The Claude CLI keeps its credentials and session
# transcripts in $HOME/.claude, so HOME must point here and must persist:
# losing it means every stored fork can no longer be resumed.
StateDirectory=odoo-claude-bot
Environment=HOME=/var/lib/odoo-claude-bot

Restart=on-failure
RestartSec=10s

# index.ts handles SIGTERM and shuts down within SHUTDOWN_GRACE_MS.
KillSignal=SIGTERM
TimeoutStopSec=60

# Hardening. StateDirectory is the only writable path; /opt and the Odoo
# workspace under /srv stay read-only to this unit.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Node's JIT requires writable-executable memory; this must stay false.
MemoryDenyWriteExecute=false
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=odoo-claude-bot

[Install]
WantedBy=multi-user.target
